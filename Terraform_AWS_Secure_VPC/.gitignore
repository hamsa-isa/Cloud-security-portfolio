# Terraform working files and provider plugins
.terraform/

# State can contain resource details and sensitive values: never commit it
*.tfstate
*.tfstate.*

# Saved plans and crash logs
*.tfplan
tfplan
crash.log
crash.*.log

# Local variable overrides may contain secrets
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Keep the provider lock file (.terraform.lock.hcl) so versions stay pinned
